<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.1.0</modelVersion>
  <parent>
    <groupId>com.guicedee.tck</groupId>
    <artifactId>microprofile-tck</artifactId>
    <version>1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>telemetry-tracing</artifactId>
  <dependencies>
    <dependency>
      <groupId>org.eclipse.microprofile.telemetry</groupId>
      <artifactId>microprofile-telemetry-tracing-tck</artifactId>
      <version>2.1</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.guicedee.tck</groupId>
      <artifactId>harness</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.guicedee</groupId>
      <artifactId>guiced-telemetry</artifactId>
      <version>${guicedee.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
      <version>7.12.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jboss.arquillian.testng</groupId>
      <artifactId>arquillian-testng-container</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <dependencies>
          <dependency>
            <groupId>org.apache.maven.surefire</groupId>
            <artifactId>surefire-testng</artifactId>
            <version>3.5.5</version>
          </dependency>
        </dependencies>
        <configuration>
          <includes>
            <include>org/eclipse/microprofile/telemetry/tracing/tck/TestApplication.java</include>
            <include>org/eclipse/microprofile/telemetry/tracing/tck/async/JaxRsClientAsyncTest.java</include>
            <include>org/eclipse/microprofile/telemetry/tracing/tck/async/JaxRsServerAsyncTest.java</include>
            <include>org/eclipse/microprofile/telemetry/tracing/tck/async/MpRestClientAsyncTest.java</include>
            <include>org/eclipse/microprofile/telemetry/tracing/tck/cdi/BaggageBeanTest.java</include>
            <include>org/eclipse/microprofile/telemetry/tracing/tck/cdi/OpenTelemetryBeanTest.java</include>
            <include>org/eclipse/microprofile/telemetry/tracing/tck/cdi/SpanBeanTest.java</include>
            <include>org/eclipse/microprofile/telemetry/tracing/tck/cdi/TracerTest.java</include>
            <include>org/eclipse/microprofile/telemetry/tracing/tck/rest/B3MultiPropagationTest.java</include>
            <include>org/eclipse/microprofile/telemetry/tracing/tck/rest/B3PropagationTest.java</include>
            <include>org/eclipse/microprofile/telemetry/tracing/tck/rest/BaggageTest.java</include>
            <include>org/eclipse/microprofile/telemetry/tracing/tck/rest/JaegerPropagationTest.java</include>
            <include>org/eclipse/microprofile/telemetry/tracing/tck/rest/PropagatorSpiTest.java</include>
            <include>org/eclipse/microprofile/telemetry/tracing/tck/rest/RestClientSpanDefaultTest.java</include>
            <include>org/eclipse/microprofile/telemetry/tracing/tck/rest/RestClientSpanDisabledTest.java</include>
            <include>org/eclipse/microprofile/telemetry/tracing/tck/rest/RestClientSpanTest.java</include>
            <include>org/eclipse/microprofile/telemetry/tracing/tck/rest/RestSpanDefaultTest.java</include>
            <include>org/eclipse/microprofile/telemetry/tracing/tck/rest/RestSpanDisabledTest.java</include>
            <include>org/eclipse/microprofile/telemetry/tracing/tck/rest/RestSpanTest.java</include>
            <include>org/eclipse/microprofile/telemetry/tracing/tck/rest/W3BaggagePropagationTest.java</include>
            <include>org/eclipse/microprofile/telemetry/tracing/tck/rest/W3PropagationTest.java</include>
            <include>org/eclipse/microprofile/telemetry/tracing/tck/spi/CustomizerSpiTest.java</include>
            <include>org/eclipse/microprofile/telemetry/tracing/tck/spi/ExporterSpiTest.java</include>
            <include>org/eclipse/microprofile/telemetry/tracing/tck/spi/ResourceSpiTest.java</include>
            <include>org/eclipse/microprofile/telemetry/tracing/tck/spi/SamplerSpiTest.java</include>
          </includes>
          <excludes>
            <exclude>**/package-info.class</exclude>
          </excludes>
          <dependenciesToScan>
            <dependency>org.eclipse.microprofile.telemetry:microprofile-telemetry-tracing-tck</dependency>
          </dependenciesToScan>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>