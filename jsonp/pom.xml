<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.guicedee.tck</groupId>
    <artifactId>microprofile-tck</artifactId>
    <version>1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>jsonp</artifactId>
  <dependencies>
    <dependency>
      <groupId>jakarta.json</groupId>
      <artifactId>jakarta.json-api</artifactId>
      <version>2.1.3</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <version>5.12.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <version>1.12.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.json</groupId>
      <artifactId>jakarta.json-tck-tests</artifactId>
      <version>2.1.1</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.guicedee.tck</groupId>
      <artifactId>harness</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.guicedee</groupId>
      <artifactId>rest</artifactId>
      <version>${guicedee.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.12.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jboss.arquillian.junit5</groupId>
      <artifactId>arquillian-junit5-container</artifactId>
      <version>1.10.2.Final</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <dependencies>
          <dependency>
            <groupId>org.apache.maven.surefire</groupId>
            <artifactId>surefire-junit-platform</artifactId>
            <version>3.5.5</version>
          </dependency>
        </dependencies>
        <configuration>
          <includes>
            <include>ee/jakarta/tck/jsonp/signaturetest/jsonp/JSONPSigTest.java</include>
            <include>ee/jakarta/tck/jsonp/api/jsonstringtests/ClientTests.java</include>
            <include>ee/jakarta/tck/jsonp/api/jsonobjecttests/ClientTests.java</include>
            <include>ee/jakarta/tck/jsonp/api/jsonwriterfactorytests/ClientTests.java</include>
            <include>ee/jakarta/tck/jsonp/api/mergetests/MergeTests.java</include>
            <include>ee/jakarta/tck/jsonp/api/jsonnumbertests/ClientTests.java</include>
            <include>ee/jakarta/tck/jsonp/api/jsonparsereventtests/ClientTests.java</include>
            <include>ee/jakarta/tck/jsonp/api/patchtests/PatchTests.java</include>
            <include>ee/jakarta/tck/jsonp/api/jsonarraytests/ClientTests.java</include>
            <include>ee/jakarta/tck/jsonp/api/jsonparsertests/ClientTests.java</include>
            <include>ee/jakarta/tck/jsonp/api/jsonstreamingtests/ClientTests.java</include>
            <include>ee/jakarta/tck/jsonp/api/pointertests/PointerTests.java</include>
            <include>ee/jakarta/tck/jsonp/api/collectortests/CollectorTests.java</include>
            <include>ee/jakarta/tck/jsonp/api/jsoncoding/ClientTests.java</include>
            <include>ee/jakarta/tck/jsonp/api/provider/JsonProviderTest.java</include>
            <include>ee/jakarta/tck/jsonp/api/jsonbuilderfactorytests/ClientTests.java</include>
            <include>ee/jakarta/tck/jsonp/api/jsonreadertests/ClientTests.java</include>
            <include>ee/jakarta/tck/jsonp/api/jsonwritertests/ClientTests.java</include>
            <include>ee/jakarta/tck/jsonp/api/jsonreaderfactorytests/ClientTests.java</include>
            <include>ee/jakarta/tck/jsonp/api/jsonvaluetests/ClientTests.java</include>
            <include>ee/jakarta/tck/jsonp/api/jsongeneratortests/ClientTests.java</include>
            <include>ee/jakarta/tck/jsonp/api/jsongeneratorfactorytests/ClientTests.java</include>
            <include>ee/jakarta/tck/jsonp/api/jsonparserfactorytests/ClientTests.java</include>
            <include>ee/jakarta/tck/jsonp/api/exceptiontests/ClientTests.java</include>
          </includes>
          <excludes>
            <exclude>**/package-info.class</exclude>
          </excludes>
          <dependenciesToScan>
            <dependency>jakarta.json:jakarta.json-tck-tests</dependency>
          </dependenciesToScan>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>