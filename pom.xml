<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.guicedee.tck</groupId>
  <artifactId>microprofile-tck</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>GuicedEE MicroProfile TCK</name>
  <properties>
    <guicedee.version>2.4.1</guicedee.version>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <arquillian.version>1.10.2.Final</arquillian.version>
    <tck.reports.directory>${project.build.directory}/surefire-reports</tck.reports.directory>
    <tck.fork.timeout>240</tck.fork.timeout>
  </properties>
  <modules>
    <module>harness</module>
    <module>config</module>
    <module>health</module>
    <module>fault-tolerance</module>
    <module>jwt</module>
    <module>openapi</module>
    <module>rest-client</module>
    <module>context-propagation</module>
    <module>graphql</module>
    <module>reactive-messaging</module>
    <module>reactive-streams</module>
    <module>lra</module>
    <module>metrics-api</module>
    <module>metrics-rest</module>
    <module>metrics-optional</module>
    <module>telemetry-tracing</module>
    <module>telemetry-metrics</module>
    <module>telemetry-logs</module>
    <module>core-profile</module>
    <module>cdi-lite</module>
    <module>cdi-lang-model</module>
    <module>jakarta-rest</module>
    <module>jsonb</module>
    <module>jsonp</module>
    <module>jsonp-pluggability</module>
    <module>jakarta-inject</module>
    <module>annotations-signature</module>
  </modules>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>5.12.2</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.jboss.arquillian</groupId>
        <artifactId>arquillian-bom</artifactId>
        <version>${arquillian.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>3.11.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.5</version>
          <configuration>
            <argLine>-XX:ActiveProcessorCount=4</argLine>
            <reportsDirectory>${tck.reports.directory}</reportsDirectory>
            <useModulePath>false</useModulePath>
            <reuseForks>false</reuseForks>
            <forkCount>1</forkCount>
            <forkedProcessTimeoutInSeconds>${tck.fork.timeout}</forkedProcessTimeoutInSeconds>
            <failIfNoTests>true</failIfNoTests>
            <includes>
              <include>**/*.java</include>
            </includes>
            <systemPropertyVariables>
              <GUICEDEE_STARTUP_TIMEOUT_SECONDS>30</GUICEDEE_STARTUP_TIMEOUT_SECONDS>
            </systemPropertyVariables>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>