<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.guicedee.tck</groupId>
    <artifactId>microprofile-tck</artifactId>
    <version>1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>telemetry-metrics</artifactId>
  <dependencies>
    <dependency>
      <groupId>org.eclipse.microprofile.telemetry</groupId>
      <artifactId>microprofile-telemetry-metrics-tck</artifactId>
      <version>2.1</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.guicedee.tck</groupId>
      <artifactId>harness</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.guicedee</groupId>
      <artifactId>guiced-telemetry</artifactId>
      <version>${guicedee.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
      <version>7.12.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jboss.arquillian.testng</groupId>
      <artifactId>arquillian-testng-container</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <dependencies>
          <dependency>
            <groupId>org.apache.maven.surefire</groupId>
            <artifactId>surefire-testng</artifactId>
            <version>3.5.5</version>
          </dependency>
        </dependencies>
        <configuration>
          <includes>
            <include>org/eclipse/microprofile/telemetry/metrics/tck/application/cdi/AsyncDoubleCounterTest.java</include>
            <include>org/eclipse/microprofile/telemetry/metrics/tck/application/cdi/AsyncLongCounterTest.java</include>
            <include>org/eclipse/microprofile/telemetry/metrics/tck/application/cdi/DoubleCounterTest.java</include>
            <include>org/eclipse/microprofile/telemetry/metrics/tck/application/cdi/DoubleGaugeTest.java</include>
            <include>org/eclipse/microprofile/telemetry/metrics/tck/application/cdi/DoubleHistogramTest.java</include>
            <include>org/eclipse/microprofile/telemetry/metrics/tck/application/cdi/DoubleUpDownCounterTest.java</include>
            <include>org/eclipse/microprofile/telemetry/metrics/tck/application/cdi/LongCounterTest.java</include>
            <include>org/eclipse/microprofile/telemetry/metrics/tck/application/cdi/LongGaugeTest.java</include>
            <include>org/eclipse/microprofile/telemetry/metrics/tck/application/cdi/LongHistogramTest.java</include>
            <include>org/eclipse/microprofile/telemetry/metrics/tck/application/cdi/LongUpDownCounterTest.java</include>
            <include>org/eclipse/microprofile/telemetry/metrics/tck/application/http/HttpHistogramTest.java</include>
            <include>org/eclipse/microprofile/telemetry/metrics/tck/jvm/JvmClassesTest.java</include>
            <include>org/eclipse/microprofile/telemetry/metrics/tck/jvm/JvmCpuTest.java</include>
            <include>org/eclipse/microprofile/telemetry/metrics/tck/jvm/JvmGarbageCollectionTest.java</include>
            <include>org/eclipse/microprofile/telemetry/metrics/tck/jvm/JvmMemoryTest.java</include>
            <include>org/eclipse/microprofile/telemetry/metrics/tck/jvm/JvmThreadTest.java</include>
          </includes>
          <excludes>
            <exclude>**/package-info.class</exclude>
          </excludes>
          <dependenciesToScan>
            <dependency>org.eclipse.microprofile.telemetry:microprofile-telemetry-metrics-tck</dependency>
          </dependenciesToScan>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>