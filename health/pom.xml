<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
  <modelVersion>4.1.0</modelVersion>
  <parent>
    <groupId>com.guicedee.tck</groupId>
    <artifactId>microprofile-tck</artifactId>
    <version>1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>health</artifactId>
  <dependencies>
    <dependency>
      <groupId>org.eclipse.microprofile.health</groupId>
      <artifactId>microprofile-health-tck</artifactId>
      <version>4.0.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.guicedee.tck</groupId>
      <artifactId>harness</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.guicedee</groupId>
      <artifactId>health</artifactId>
      <version>${guicedee.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
      <version>7.12.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jboss.arquillian.testng</groupId>
      <artifactId>arquillian-testng-container</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <dependencies>
          <dependency>
            <groupId>org.apache.maven.surefire</groupId>
            <artifactId>surefire-testng</artifactId>
            <version>3.5.5</version>
          </dependency>
        </dependencies>
        <configuration>
          <includes>
            <include>org/eclipse/microprofile/health/tck/CDIProducedProceduresTest.java</include>
            <include>org/eclipse/microprofile/health/tck/ConfigTest.java</include>
            <include>org/eclipse/microprofile/health/tck/DelayedCheckTest.java</include>
            <include>org/eclipse/microprofile/health/tck/DelegateHealthSuccessfulTest.java</include>
            <include>org/eclipse/microprofile/health/tck/EnforceQualifierTest.java</include>
            <include>org/eclipse/microprofile/health/tck/HealthCheckResponseAttributesTest.java</include>
            <include>org/eclipse/microprofile/health/tck/HealthCheckResponseValidationTest.java</include>
            <include>org/eclipse/microprofile/health/tck/JsonSchemaValidationTest.java</include>
            <include>org/eclipse/microprofile/health/tck/MultipleLivenessFailedTest.java</include>
            <include>org/eclipse/microprofile/health/tck/MultipleProceduresFailedTest.java</include>
            <include>org/eclipse/microprofile/health/tck/MultipleReadinessFailedTest.java</include>
            <include>org/eclipse/microprofile/health/tck/MultipleStartupFailedTest.java</include>
            <include>org/eclipse/microprofile/health/tck/NoProcedureSuccessfulTest.java</include>
            <include>org/eclipse/microprofile/health/tck/OnlySuccessfulProcedureTest.java</include>
            <include>org/eclipse/microprofile/health/tck/SingleLivenessFailedTest.java</include>
            <include>org/eclipse/microprofile/health/tck/SingleLivenessSuccessfulTest.java</include>
            <include>org/eclipse/microprofile/health/tck/SingleReadinessFailedTest.java</include>
            <include>org/eclipse/microprofile/health/tck/SingleReadinessSuccessfulTest.java</include>
            <include>org/eclipse/microprofile/health/tck/SingleStartupFailedTest.java</include>
            <include>org/eclipse/microprofile/health/tck/SingleStartupSuccessfulTest.java</include>
          </includes>
          <excludes>
            <exclude>**/package-info.class</exclude>
          </excludes>
          <dependenciesToScan>
            <dependency>org.eclipse.microprofile.health:microprofile-health-tck</dependency>
          </dependenciesToScan>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>