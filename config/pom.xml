<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.1.0</modelVersion>
  <parent>
    <groupId>com.guicedee.tck</groupId>
    <artifactId>microprofile-tck</artifactId>
    <version>1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>config</artifactId>
  <dependencies>
    <dependency>
      <groupId>org.eclipse.microprofile.config</groupId>
      <artifactId>microprofile-config-tck</artifactId>
      <version>3.1.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.guicedee.tck</groupId>
      <artifactId>harness</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.guicedee.microprofile</groupId>
      <artifactId>config</artifactId>
      <version>${guicedee.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
      <version>7.12.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jboss.arquillian.testng</groupId>
      <artifactId>arquillian-testng-container</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <dependencies>
          <dependency>
            <groupId>org.apache.maven.surefire</groupId>
            <artifactId>surefire-testng</artifactId>
            <version>3.5.5</version>
          </dependency>
        </dependencies>
        <configuration>
          <includes>
            <include>org/eclipse/microprofile/config/tck/converters/NullConvertersTest.java</include>
            <include>org/eclipse/microprofile/config/tck/converters/convertToNull/ConvertedNullValueBrokenInjectionTest.java</include>
            <include>org/eclipse/microprofile/config/tck/converters/convertToNull/ConvertedNullValueTest.java</include>
            <include>org/eclipse/microprofile/config/tck/ArrayConverterTest.java</include>
            <include>org/eclipse/microprofile/config/tck/AutoDiscoveredConfigSourceTest.java</include>
            <include>org/eclipse/microprofile/config/tck/CDIPlainInjectionTest.java</include>
            <include>org/eclipse/microprofile/config/tck/CDIPropertyExpressionsTest.java</include>
            <include>org/eclipse/microprofile/config/tck/CDIPropertyNameMatchingTest.java</include>
            <include>org/eclipse/microprofile/config/tck/CdiOptionalInjectionTest.java</include>
            <include>org/eclipse/microprofile/config/tck/ClassConverterTest.java</include>
            <include>org/eclipse/microprofile/config/tck/ConfigPropertiesTest.java</include>
            <include>org/eclipse/microprofile/config/tck/ConfigProviderTest.java</include>
            <include>org/eclipse/microprofile/config/tck/ConfigValueTest.java</include>
            <include>org/eclipse/microprofile/config/tck/ConverterTest.java</include>
            <include>org/eclipse/microprofile/config/tck/CustomConfigSourceTest.java</include>
            <include>org/eclipse/microprofile/config/tck/CustomConverterTest.java</include>
            <include>org/eclipse/microprofile/config/tck/ImplicitConverterTest.java</include>
            <include>org/eclipse/microprofile/config/tck/PropertyExpressionsTest.java</include>
            <include>org/eclipse/microprofile/config/tck/WarPropertiesLocationTest.java</include>
            <include>org/eclipse/microprofile/config/tck/broken/ConfigPropertiesMissingPropertyInjectionTest.java</include>
            <include>org/eclipse/microprofile/config/tck/broken/MissingConverterOnInstanceInjectionTest.java</include>
            <include>org/eclipse/microprofile/config/tck/broken/MissingValueOnInstanceInjectionTest.java</include>
            <include>org/eclipse/microprofile/config/tck/broken/MissingValueOnObserverMethodInjectionTest.java</include>
            <include>org/eclipse/microprofile/config/tck/broken/WrongConverterOnInstanceInjectionTest.java</include>
            <include>org/eclipse/microprofile/config/tck/configsources/DefaultConfigSourceOrdinalTest.java</include>
            <include>org/eclipse/microprofile/config/tck/emptyvalue/EmptyValuesTest.java</include>
            <include>org/eclipse/microprofile/config/tck/emptyvalue/EmptyValuesTestProgrammaticLookup.java</include>
            <include>org/eclipse/microprofile/config/tck/profile/ConfigPropertyFileProfileTest.java</include>
            <include>org/eclipse/microprofile/config/tck/profile/DevConfigProfileTest.java</include>
            <include>org/eclipse/microprofile/config/tck/profile/InvalidConfigProfileTest.java</include>
            <include>org/eclipse/microprofile/config/tck/profile/OverrideConfigProfileTest.java</include>
            <include>org/eclipse/microprofile/config/tck/profile/ProdProfileTest.java</include>
            <include>org/eclipse/microprofile/config/tck/profile/TestConfigProfileTest.java</include>
            <include>org/eclipse/microprofile/config/tck/profile/TestCustomConfigProfile.java</include>
          </includes>
          <excludes>
            <exclude>**/package-info.class</exclude>
          </excludes>
          <dependenciesToScan>
            <dependency>org.eclipse.microprofile.config:microprofile-config-tck</dependency>
          </dependenciesToScan>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>