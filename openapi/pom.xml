<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
  <modelVersion>4.1.0</modelVersion>
  <parent>
    <groupId>com.guicedee.tck</groupId>
    <artifactId>microprofile-tck</artifactId>
    <version>1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>openapi</artifactId>
  <dependencies>
    <dependency>
      <groupId>org.eclipse.microprofile.openapi</groupId>
      <artifactId>microprofile-openapi-tck</artifactId>
      <version>4.1.1</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.guicedee.tck</groupId>
      <artifactId>harness</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.guicedee</groupId>
      <artifactId>openapi</artifactId>
      <version>${guicedee.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
      <version>7.12.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jboss.arquillian.testng</groupId>
      <artifactId>arquillian-testng-container</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <dependencies>
          <dependency>
            <groupId>org.apache.maven.surefire</groupId>
            <artifactId>surefire-testng</artifactId>
            <version>3.5.5</version>
          </dependency>
        </dependencies>
        <configuration>
          <includes>
            <include>org/eclipse/microprofile/openapi/tck/AirlinesAppTest.java</include>
            <include>org/eclipse/microprofile/openapi/tck/FilterTest.java</include>
            <include>org/eclipse/microprofile/openapi/tck/ModelConstructionTest.java</include>
            <include>org/eclipse/microprofile/openapi/tck/ModelReaderAppTest.java</include>
            <include>org/eclipse/microprofile/openapi/tck/ModelReaderAppWithJustComponentTest.java</include>
            <include>org/eclipse/microprofile/openapi/tck/ModelReaderAppWithJustWebHookTest.java</include>
            <include>org/eclipse/microprofile/openapi/tck/OASConfigScanDisableTest.java</include>
            <include>org/eclipse/microprofile/openapi/tck/OASConfigSchemaTest.java</include>
            <include>org/eclipse/microprofile/openapi/tck/OASConfigServersTest.java</include>
            <include>org/eclipse/microprofile/openapi/tck/OASConfigWebInfTest.java</include>
            <include>org/eclipse/microprofile/openapi/tck/OASFactoryErrorTest.java</include>
            <include>org/eclipse/microprofile/openapi/tck/OASScanConfigTests$ScanConfigIncludeOnly.java</include>
            <include>org/eclipse/microprofile/openapi/tck/OASScanConfigTests$ScanConfigIncludeMultiple.java</include>
            <include>org/eclipse/microprofile/openapi/tck/OASScanConfigTests$ScanConfigPackageIncludeOnly.java</include>
            <include>org/eclipse/microprofile/openapi/tck/OASScanConfigTests$ScanConfigPackageIncludeMultiple.java</include>
            <include>org/eclipse/microprofile/openapi/tck/OASScanConfigTests$ScanConfigExcludeOnly.java</include>
            <include>org/eclipse/microprofile/openapi/tck/OASScanConfigTests$ScanConfigExcludeMultiple.java</include>
            <include>org/eclipse/microprofile/openapi/tck/OASScanConfigTests$ScanConfigPackageExcludeOnly.java</include>
            <include>org/eclipse/microprofile/openapi/tck/OASScanConfigTests$ScanConfigPackageExcludeMultiple.java</include>
            <include>org/eclipse/microprofile/openapi/tck/OASScanConfigTests$ScanConfigPackageIncludesAroundExcludes.java</include>
            <include>org/eclipse/microprofile/openapi/tck/OASScanConfigTests$ScanConfigPackageExcludesAroundInclude.java</include>
            <include>org/eclipse/microprofile/openapi/tck/OASScanConfigTests$ScanConfigPackageExcludeClassInclude.java</include>
            <include>org/eclipse/microprofile/openapi/tck/OASScanConfigTests$ScanConfigPackageIncludeClassExclude.java</include>
            <include>org/eclipse/microprofile/openapi/tck/OASScanConfigTests$ScanConfigPartialPackage.java</include>
            <include>org/eclipse/microprofile/openapi/tck/PetStoreAppTest.java</include>
            <include>org/eclipse/microprofile/openapi/tck/StaticDocumentCustomDialectTest.java</include>
            <include>org/eclipse/microprofile/openapi/tck/StaticDocumentTest.java</include>
            <include>org/eclipse/microprofile/openapi/tck/beanvalidation/BeanValidationTest.java</include>
            <include>org/eclipse/microprofile/openapi/tck/beanvalidation/BeanValidationDisabledTest.java</include>
          </includes>
          <excludes>
            <exclude>**/package-info.class</exclude>
          </excludes>
          <dependenciesToScan>
            <dependency>org.eclipse.microprofile.openapi:microprofile-openapi-tck</dependency>
          </dependenciesToScan>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>