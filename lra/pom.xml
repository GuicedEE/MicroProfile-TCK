<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.1.0</modelVersion>
  <parent>
    <groupId>com.guicedee.tck</groupId>
    <artifactId>microprofile-tck</artifactId>
    <version>1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>lra</artifactId>
  <dependencies>
    <dependency>
      <groupId>org.eclipse.microprofile.lra</groupId>
      <artifactId>microprofile-lra-tck</artifactId>
      <version>2.0.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.guicedee.tck</groupId>
      <artifactId>harness</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.guicedee</groupId>
      <artifactId>rest</artifactId>
      <version>${guicedee.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jboss.arquillian.junit</groupId>
      <artifactId>arquillian-junit-container</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <dependencies>
          <dependency>
            <groupId>org.apache.maven.surefire</groupId>
            <artifactId>surefire-junit47</artifactId>
            <version>3.5.5</version>
          </dependency>
        </dependencies>
        <configuration>
          <includes>
            <include>org/eclipse/microprofile/lra/tck/TckCancelOnTests.java</include>
            <include>org/eclipse/microprofile/lra/tck/TckContextTests.java</include>
            <include>org/eclipse/microprofile/lra/tck/TckInvalidSignaturesTests.java</include>
            <include>org/eclipse/microprofile/lra/tck/TckLRATypeTests.java</include>
            <include>org/eclipse/microprofile/lra/tck/TckParticipantTests.java</include>
            <include>org/eclipse/microprofile/lra/tck/TckRecoveryTests.java</include>
            <include>org/eclipse/microprofile/lra/tck/TckTests.java</include>
            <include>org/eclipse/microprofile/lra/tck/TckUnknownStatusTests.java</include>
            <include>org/eclipse/microprofile/lra/tck/TckUnknownTests.java</include>
          </includes>
          <excludes>
            <exclude>**/package-info.class</exclude>
          </excludes>
          <dependenciesToScan>
            <dependency>org.eclipse.microprofile.lra:microprofile-lra-tck</dependency>
          </dependenciesToScan>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>