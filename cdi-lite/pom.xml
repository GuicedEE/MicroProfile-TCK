<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.guicedee.tck</groupId>
    <artifactId>microprofile-tck</artifactId>
    <version>1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>cdi-lite</artifactId>
  <properties>
    <tck.cdi.suite>${project.basedir}/../target/core-profile/core-profile-tck-10.0.1/artifacts/cdi-lite-tck-suite-10.0.1.xml</tck.cdi.suite>
  </properties>
  <dependencies>
    <dependency>
      <groupId>jakarta.enterprise</groupId>
      <artifactId>cdi-tck-core-impl</artifactId>
      <version>4.0.13</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.guicedee.tck</groupId>
      <artifactId>harness</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.guicedee</groupId>
      <artifactId>cdi</artifactId>
      <version>${guicedee.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
      <version>7.4.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jboss.arquillian.testng</groupId>
      <artifactId>arquillian-testng-container</artifactId>
      <version>1.10.2.Final</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.ee.tck.coreprofile</groupId>
      <artifactId>cdi-lite-tck-suite</artifactId>
      <version>10.0.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <dependencies>
          <dependency>
            <groupId>org.apache.maven.surefire</groupId>
            <artifactId>surefire-testng</artifactId>
            <version>3.5.5</version>
          </dependency>
        </dependencies>
        <configuration>
          <systemPropertyVariables>
            <tck.cdi.parameters>true</tck.cdi.parameters>
          </systemPropertyVariables>
          <suiteXmlFiles>
            <suiteXmlFile>${tck.cdi.suite}</suiteXmlFile>
          </suiteXmlFiles>
          <dependenciesToScan>
            <dependency>jakarta.enterprise:cdi-tck-core-impl</dependency>
          </dependenciesToScan>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
